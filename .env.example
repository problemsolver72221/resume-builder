# Copy to .env and fill in what you use. Every secret this app needs lives in .env,
# which is gitignored — nothing in backend/data/ should ever hold a key.
#
# At least one AI provider key is required. The first provider enabled in
# Admin > Settings that also has a key here is the one the builder picks by default.

# ── AI providers ───────────────────────────────────────────────────────────────
# Each *_MODEL is a comma-separated list; the first entry is that provider's default,
# and every entry becomes its own choice in the builder's model picker.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.4-nano

# https://you.bot
YOUBOT_API_KEY=
# YOUBOT_MODEL=claude-sonnet-5,claude-haiku-4-5,gpt-5-6-luna,gemini-3-7-flash,gemini-3-8-flash,gemini-3-flash
# YOUBOT_REASONING_EFFORT=Low

# https://cheapai.io — OpenAI-compatible; model ids as listed at https://cheapai.io/models
CHEAPAI_API_KEY=
# CHEAPAI_MODEL=claude-haiku-4-5-20251001,claude-sonnet-5,gpt-5.6-luna,gemini-3.7-flash,gemini-3.8-flash
# CHEAPAI_REASONING_EFFORT=low   # its Claude models think at length (and time out) at anything higher

# ── Google Sheets import ───────────────────────────────────────────────────────
# From a service-account JSON key: copy client_email and private_key. Keep the private
# key on ONE line in double quotes, with each line break written as the two characters \n:
#   GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Share the spreadsheet with the service account's email address, or reads will 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── Admin ──────────────────────────────────────────────────────────────────────
# Signing secret for the admin session token. NOT a credential: the backend accepts any
# password today — see "A note on the admin panel" in the README.
ADMIN_PASSWORD=

# ── Optional tuning (defaults shown) ───────────────────────────────────────────
# PORT=3001                    # first backend port tried; a taken one is skipped
# FRONTEND_URL=                # extra CORS origins, comma-separated; any localhost port is allowed already
# AI_RETRY_BUDGET_MS=600000    # how long one AI call keeps retrying transient failures
# BUILD_DEADLINE_MS=1800000    # a resume route answers within this, or with a retryable 503
# AI_KEY_DEBUG=1               # log which (masked) key each AI call used
